<view class="page">
  <view class="card">
    <view class="title">员工登录</view>
    <input class="input" placeholder="工号 (如 E001)" value="{{employeeNo}}" bindinput="onNoInput" />
    <input class="input" placeholder="密码" password value="{{password}}" bindinput="onPwdInput" />
    <button class="btn" type="primary" loading="{{loading}}" bindtap="onLogin">登录</button>
  </view>
</view>
