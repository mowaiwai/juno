<view class="page">
  <view class="idp" wx:for="{{idps}}" wx:key="id">
    <view class="period">{{item.period}}</view>
    <view class="row"><text class="label">目标能力</text><text>{{item.target_ability}}</text></view>
    <view class="row"><text class="label">状态</text><text class="status">{{item.status}}</text></view>
    <view class="row" wx:if="{{item.ai_label}}"><text class="label">来源</text><text>AI 生成·待审核</text></view>
    <view class="plan" wx:for="{{item.key_behavior_plan}}" wx:for-item="p" wx:key="behavior">
      <view class="plan-item">· {{p.behavior}} — {{p.action}}（{{p.deadline}}）</view>
    </view>
    <view class="row" wx:if="{{item.review_conclusion}}"><text class="label">复盘</text><text>{{item.review_conclusion}}</text></view>
  </view>
  <view wx:if="{{!idps.length && !loading}}" class="empty">暂无 IDP</view>
</view>
