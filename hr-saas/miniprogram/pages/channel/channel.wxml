<view class="page">
  <view class="section">
    <view class="h2">软件研发序列 P1–P5</view>
    <view class="ch-item" wx:for="{{channels}}" wx:key="id">
      <view class="grade">{{item.grade}}</view>
      <view class="role">{{item.role_definition}}</view>
    </view>
  </view>
  <view class="section" wx:if="{{standards.length}}">
    <view class="h2">各级标准摘要</view>
    <view class="std" wx:for="{{standards}}" wx:key="id">
      <view class="std-title">{{item.grade}} 标准（v{{item.version}}）</view>
      <view class="std-line">学历：{{item.basic_condition.education || '不限'}}；工龄：{{item.basic_condition.work_years || 0}} 年</view>
      <view class="std-line">职责 {{item.duty_count}} 项；知识点 {{item.knowledge_count}} 项</view>
    </view>
  </view>
  <view wx:if="{{loading}}" class="loading">加载中…</view>
</view>
