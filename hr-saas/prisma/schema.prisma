// MVP data model — spec.md「数据模型」
// Dev DB: SQLite (local MySQL unavailable). Schema kept MySQL-compatible:
// no enums, no native Json (JSON payloads stored as String), no Decimal.
// Switch provider to "mysql" + DATABASE_URL for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Platform ----------

model tenant {
  id         String   @id
  name       String
  code       String   @unique
  status     Int      @default(1) // 1 active 0 disabled
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model tenant_config {
  id           String   @id
  tenant_id    String
  config_key   String
  config_value String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([tenant_id, config_key])
  @@index([tenant_id])
}

model ai_usage {
  id                String   @id
  tenant_id         String
  scene             String // exam_generate | idp_draft
  model             String
  prompt_tokens     Int      @default(0)
  completion_tokens Int      @default(0)
  request_summary   String   @default("")
  response_summary  String   @default("")
  desensitized      Int      @default(0) // 1 if payload was desensitized
  created_by        String   @default("")
  created_at        DateTime @default(now())

  @@index([tenant_id])
}

// ---------- Master data ----------

model org_department {
  id         String   @id
  tenant_id  String
  parent_id  String? // null = root
  name       String
  sort       Int      @default(0)
  is_deleted Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([tenant_id, parent_id])
}

model qc_channel {
  id              String   @id
  tenant_id       String
  family          String // P | T | M
  sequence_name   String // e.g. 软件研发
  grade           String // P1..P5
  grade_order     Int // 1..5 for ordering
  role_definition String   @default("")
  is_deleted      Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([tenant_id, sequence_name, grade])
  @@index([tenant_id])
}

model org_position {
  id         String   @id
  tenant_id  String
  name       String
  channel_id String? // null for background (non-target) positions
  is_deleted Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([tenant_id])
}

model org_employee {
  id          String   @id
  tenant_id   String
  employee_no String
  name        String
  dept_id     String
  position_id String
  grade       String // current grade e.g. P2
  role        String   @default("EMPLOYEE") // EMPLOYEE | HR | MANAGER | EXEC
  manager_id  String? // direct manager employee id
  hire_date   DateTime?
  education   String   @default("") // 高中/大专/本科/硕士/博士
  status      Int      @default(1)
  is_deleted  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([tenant_id, employee_no])
  @@index([tenant_id, dept_id])
}

// ---------- Standard library ----------

model qc_standard {
  id              String   @id
  tenant_id       String
  channel_id      String
  grade           String // target grade this standard describes
  version         String   @default("1.0")
  status          Int      @default(1) // 0 draft 1 effective 2 retired
  basic_condition String   @default("{}") // JSON: {education, work_years, qualification}
  perf_condition  String   @default("{}") // JSON: {recent_two_year_min_a, recent_year_min_grade}
  is_deleted      Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([tenant_id, channel_id, version])
  @@index([tenant_id])
}

model qc_standard_duty {
  id                  String   @id
  tenant_id           String
  standard_id         String
  duty_item           String
  completion_standard String   @default("")
  duty_level          Int      @default(1) // 履职四级 1-4
  sort                Int      @default(0)
  created_at          DateTime @default(now())

  @@index([tenant_id, standard_id])
}

model qc_standard_knowledge {
  id              String   @id
  tenant_id       String
  standard_id     String
  category        String   @default("专业") // 通用/专业/行业
  knowledge_point String
  mastery_level   Int // 知识四档 1了解 2掌握 3熟练掌握 4精通
  sort            Int      @default(0)
  created_at      DateTime @default(now())

  @@index([tenant_id, standard_id])
}

model qc_standard_ability {
  id           String   @id
  tenant_id    String
  standard_id  String
  ability_item String
  key_behavior String   @default("")
  sort         Int      @default(0)
  created_at   DateTime @default(now())

  @@index([tenant_id, standard_id])
}

// ---------- Business chain ----------

model perf_result {
  id           String   @id
  tenant_id    String
  employee_id  String
  period       String // e.g. 2024H1 / 2024 / 2025Q1
  grade        String // S A B C D
  source       Int      @default(1) // 1 csv import 2 manual
  import_batch String   @default("")
  remark       String   @default("")
  created_by   String   @default("")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  is_deleted   Int      @default(0)

  @@unique([tenant_id, employee_id, period])
  @@index([tenant_id, employee_id])
}

model cert_record {
  id               String   @id
  tenant_id        String
  employee_id      String
  channel_id       String
  from_grade       String
  to_grade         String
  status           String // DRAFT? main chain: INITIATED/HARD_CHECK_PASSED/MATERIAL_REVIEW/EXAM/DEFENSE_REVIEW/EFFECTIVE + exceptions
  current_node     String   @default("")
  review_route     String   @default("") // MANAGER_SINGLE | PANEL_VOTE | COMMITTEE_FINAL
  exam_record_id   String?
  retake_count     Int      @default(0)
  resubmit_count   Int      @default(0)
  terminate_reason String   @default("")
  materials        String   @default("[]") // JSON array of evidence items
  applied_at       DateTime @default(now())
  effective_at     DateTime?
  closed_at        DateTime?
  created_by       String   @default("")
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  is_deleted       Int      @default(0)

  @@index([tenant_id, employee_id])
  @@index([tenant_id, status])
}

model cert_review_vote {
  id         String   @id
  tenant_id  String
  cert_id    String
  voter_id   String
  approve    Int // 1 yes 0 no
  role       String   @default("") // MANAGER / PANEL_MEMBER / COMMITTEE
  created_at DateTime @default(now())

  @@unique([tenant_id, cert_id, voter_id])
  @@index([tenant_id, cert_id])
}

model cert_audit_log {
  id          String   @id
  tenant_id   String
  cert_id     String
  from_status String
  to_status   String
  action      String
  operator_id String
  reason      String   @default("")
  created_at  DateTime @default(now())

  @@index([tenant_id, cert_id])
}

model exam_paper {
  id          String   @id
  tenant_id   String
  standard_id String
  grade       String
  title       String   @default("")
  source      Int      @default(1) // 1 AI generated 2 manual
  status      String   @default("AI_PENDING_REVIEW") // AI_PENDING_REVIEW | PUBLISHED | DISCARDED
  pass_score  Int      @default(60)
  total_score Int      @default(100)
  reviewed_by String   @default("")
  reviewed_at DateTime?
  created_by  String   @default("")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  is_deleted  Int      @default(0)

  @@index([tenant_id, standard_id])
}

model exam_question {
  id           String   @id
  tenant_id    String
  paper_id     String
  knowledge_id String? // source knowledge point
  type         String // CHOICE | FILL | QA | DEFENSE
  stem         String
  options      String   @default("[]") // JSON for CHOICE
  answer       String   @default("")
  score        Int      @default(10)
  source       Int      @default(1) // 1 AI pending review 2 AI reviewed
  sort         Int      @default(0)
  created_at   DateTime @default(now())

  @@index([tenant_id, paper_id])
}

model exam_record {
  id             String   @id
  tenant_id      String
  paper_id       String
  employee_id    String
  cert_id        String?
  is_retake      Int      @default(0)
  objective_score Int     @default(0)
  manual_score   Int?
  total_score    Int?
  passed         Int? // 1 pass 0 fail, null = pending manual grading
  answers        String   @default("[]") // JSON [{question_id, answer, score, graded_by}]
  status         String   @default("SUBMITTED") // SUBMITTED | GRADED
  submitted_at   DateTime @default(now())
  graded_at      DateTime?
  created_at     DateTime @default(now())

  @@index([tenant_id, employee_id])
}

model profile_snapshot {
  id             String   @id
  tenant_id      String
  employee_id    String
  period         String
  version        Int      @default(1)
  current_grade  String   @default("")
  dimension_data String   @default("{}") // JSON seven dimensions
  trigger_source String   @default("") // perf_import | cert_effective
  is_current     Int      @default(1)
  created_by     String   @default("system")
  created_at     DateTime @default(now())

  @@unique([tenant_id, employee_id, period, version])
  @@index([tenant_id, employee_id])
}

model gap_analysis {
  id             String   @id
  tenant_id      String
  employee_id    String
  standard_id    String
  batch_id       String   @default("")
  gap_type       String // PERFORMANCE | DUTY | ABILITY | TEAM_CONTRIB | KNOWLEDGE
  gap_detail     String   @default("")
  severity       String   @default("MEDIUM") // HIGH | MEDIUM | LOW
  suggest_action String   @default("")
  status         String   @default("OPEN") // OPEN | ROUTED | CLOSED
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([tenant_id, employee_id])
  @@index([tenant_id, batch_id])
}

model idp {
  id                 String   @id
  tenant_id          String
  employee_id        String
  period             String // quarter e.g. 2026Q3
  source             Int      @default(2) // 1 AI draft 2 manual
  status             String   @default("DRAFT") // DRAFT | PENDING_CONFIRM | EFFECTIVE | CLOSED
  target_ability     String   @default("")
  key_behavior_plan  String   @default("[]") // JSON array
  gap_ids            String   @default("[]") // JSON array of gap_analysis ids
  review_conclusion  String   @default("")
  confirmed_by       String   @default("")
  confirmed_at       DateTime?
  ai_label           Int      @default(0) // 1 = AI 生成·待审核
  created_by         String   @default("")
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  is_deleted         Int      @default(0)

  @@index([tenant_id, employee_id])
}
