# ── 必填：生产环境请改为随机长字符串（如 openssl rand -hex 32）────────
JUNO_SECRET_KEY=please-change-to-a-long-random-string

# ── 数据库 ────────────────────────────────────────────────────────────
JUNO_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/juno

# ── CORS：逗号分隔的允许来源，生产环境必须改为前端正式域名 ─────────────
JUNO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 登录令牌有效期（分钟，默认 1440=24h）──────────────────────────────
JUNO_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── 举证材料存储 ──────────────────────────────────────────────────────
JUNO_STORAGE_DIR=storage

# ── 登录限流（同一账号/IP 每分钟最大尝试次数）─────────────────────────
JUNO_LOGIN_RATE_LIMIT_PER_MINUTE=10

# ── 内置定时调度（每日超期推进/催办），多实例可只在一个实例开启 ────────
JUNO_SCHEDULER_ENABLED=true

# ── 首个租户与租户管理员初始化（四项均填写时，启动自动幂等创建）────────
# 生产首次部署填写；创建后建议清空或在编排平台移除这些变量
JUNO_INIT_TENANT_NAME=
JUNO_INIT_ADMIN_NAME=
JUNO_INIT_ADMIN_EMAIL=
JUNO_INIT_ADMIN_PASSWORD=

# ── 国内合规模型直连（OpenAI 兼容协议）───────────────────────────────
JUNO_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
JUNO_LLM_MODEL=qwen-plus
JUNO_LLM_API_KEY=
JUNO_LLM_TIMEOUT_SECONDS=60
JUNO_AI_MAX_ATTEMPTS=3
